# Firebase client config for the Unity app.
#
# 1. Create your own Firebase project (README → Quick Start → Firebase).
# 2. Copy this file to `.env` in the project root. `.env` is git-ignored.
# 3. Replace the values below. Unity generates the Firebase config files from
#    `.env` when the project loads and again before every build.
#
# These values are bundled into every build, so never put admin service-account
# keys here.

# Shared
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PROJECT_NUMBER=your-project-number
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# Android
FIREBASE_ANDROID_PACKAGE_NAME=com.hfm.hickstudy
FIREBASE_ANDROID_APP_ID=your-android-app-id
FIREBASE_ANDROID_API_KEY=your-android-api-key

# iOS (only needed for iOS builds)
FIREBASE_IOS_BUNDLE_ID=com.hfm.hickstudy.app
FIREBASE_IOS_APP_ID=your-ios-app-id
FIREBASE_IOS_API_KEY=your-ios-api-key

# Optional: web page opened with ?testId=... after a session. Leave empty to skip.
FIREBASE_REPORT_URL=
